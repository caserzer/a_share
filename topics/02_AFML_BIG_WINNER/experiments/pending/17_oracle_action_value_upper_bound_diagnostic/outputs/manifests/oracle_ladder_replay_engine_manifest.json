    "qfq_close_abs_tolerance": 1e-09,
    "return_abs_tolerance": 1e-09
  },
  "return_formula": "baseline=forward_return_h20; defend=q_defend*forward_return_h20-cost_bps/10000; incremental=policy-baseline",
