{
  "schema_version": "D2-v1",
  "domain": "financial_versions",
  "format": "Parquet exchange table; timestamps require timezone contract",
  "required_provenance": {
    "event_time": "fact occurrence or report period",
    "effective_time": "economic validity start",
    "known_at": "verified first release or null; never ingestion backdated",
    "source_observed_at": "actual observation UTC or offset timestamp",
    "ingested_at": "actual ingestion timestamp",
    "vendor_revision_time": "vendor clock or null",
    "source_uri": "source or announcement id",
    "source_sha256": "SHA256 of preserved source bytes",
    "unit": "explicit unit",
    "original_version": "source vintage id",
    "transform_sha256": "transformation code SHA256",
    "quality_tier": "four-tier classification"
  },
  "fields": {
    "security_id": "id",
    "report_period": "report end",
    "field": "statement and item",
    "value": "numeric or null",
    "first_release_date": "actual original disclosure, not UPDATE_DATE",
    "restated": "true/false/unknown",
    "supersedes": "preserved record id or null",
    "extraction_page": "source page and cell"
  },
  "null_policy": "unknown is null with explicit reason; no synthetic zeros",
  "publication_rule": "date only becomes available next verified session open",
  "version_rule": "append only"
}
