# Copy to /home/xiaolv/code/RD-Agent/.env only when an agent-loop run is authorized.
# Never commit real credentials.

CHAT_MODEL=openrouter/openai/gpt-5.6-sol-pro
EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small

# OpenRouter through the required HTTP proxy.
OPENAI_API_KEY=<openrouter-secret>
OPENAI_API_BASE=https://openrouter.ai/api/v1
HTTP_PROXY=http://192.168.100.129:10118
HTTPS_PROXY=http://192.168.100.129:10118

# Required by the installed MLflow version when Qlib uses a file backend.
MLFLOW_ALLOW_FILE_STORE=true

# Other supported providers, unused by EP23:
# AZURE_API_KEY=<secret>
# AZURE_API_BASE=<endpoint>
# AZURE_API_VERSION=<api-version>
# LITELLM_PROXY_API_KEY=<secret>
# LITELLM_PROXY_API_BASE=<endpoint>
